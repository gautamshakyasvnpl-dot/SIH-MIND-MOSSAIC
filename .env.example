# AI provider (pick ONE backend; leave both blank for pure-heuristic mode)
# Option A - any OpenAI-compatible endpoint
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=
STT_PROVIDER=
TTS_PROVIDER=
# Option B - Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Database / auth
DATABASE_URL=sqlite:///./sahaik.db
JWT_SECRET=change-me-in-production

# Storage
# where uploaded documents and generated audio live; Docker sets /data/uploads on a mounted volume
UPLOAD_DIR=uploads
# comma-separated CORS allowlist for production frontends
ALLOWED_ORIGINS=http://localhost:5173

# Frontend
VITE_API_BASE=http://localhost:8000
